# Local development only. npm start defaults to 8787 when PORT is unset.
PORT=8787

# Optional: additional browser origins. The request's own origin is allowed automatically.
# ALLOWED_ORIGINS=https://your-project.vercel.app

# Production only: add the Redis Cloud Marketplace connection URI as the REDIS_URL
# server-side Vercel environment variable. It is a secret and must never be committed.
# REDIS_URL=

# Optional: set a high-entropy server-side token to enable participant reports and
# the authenticated GET/DELETE /api/reports moderator workflow.
# REPORT_ADMIN_TOKEN=
